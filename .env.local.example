# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — only used server-side (admin operations like setting roles)
# NEVER expose this in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── APP ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bedfordviewcc.co.za

# ── WEBHOOKS ──────────────────────────────────────────────────────────────────
# Shared secret verified by Supabase DB webhook edge functions to authenticate
# incoming webhook requests. Set the same value in Supabase Dashboard →
# Database → Webhooks → HTTP Headers (e.g. x-webhook-secret).
WEBHOOK_SECRET=b98de70e13a2da6adbb92cf6b150d63eb96321d5192a706401865cc7f0b66b45

# ── PAYMENTS / BANKING ────────────────────────────────────────────────────────
# Bank account details shown on the membership and shop payment pages.
NEXT_PUBLIC_ACCOUNT_NUMBER=your-bank-account-number
NEXT_PUBLIC_BRANCH_CODE=your-branch-code
NEXT_PUBLIC_BANK_NAME=Your Bank Name

# ── CRON ──────────────────────────────────────────────────────────────────────
# Random secret used by Vercel Cron to authenticate POST /api/cron/reset-demo
CRON_SECRET=your-random-secret-here
